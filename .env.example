# Copier ce fichier en .env et renseigner les valeurs. Ne jamais commiter le .env.

# API
PORT=3000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/vigie

# JWT
JWT_SECRET=a_remplacer_par_une_longue_chaine_aleatoire
JWT_EXPIRES_IN=8h

# bcrypt (coût de 10 à 12)
BCRYPT_COST=12

# SMTP (Mailtrap en développement et pour la démo)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VIGIE <no-reply@vigie.local>"

# SLA : heures ouvrées et seuil d'alerte orange
SLA_WORK_DAYS=1,2,3,4,5
SLA_WORK_START=09:00
SLA_WORK_END=18:00
SLA_WARNING_RATIO=0.75

# Relances (en jours)
REMINDER_DELAY_DAYS=3

# Pièces jointes
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=5
UPLOAD_MAX_FILES=5
